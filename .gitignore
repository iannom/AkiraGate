# ============================================
#  AkiraGate .gitignore
# ============================================

# ---- Go 编译产物 ----
userspace-gateway/akiragate-server
userspace-gateway/akiragate-gateway

# ---- 前端依赖和构建产物 ----
frontend/node_modules/
frontend/dist/

# ---- Debian 打包产物 ----
*.deb
akiragate_*

# ---- 运行时数据 ----
.dev/
akiragate_data/
docker-data/
vpngate_data/
logs/
*.log
*.tmp
*.pid

# ---- 本地容器环境变量 ----
.env

# ---- IDE 和编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---- AI 编码助手 ----
.gemini/
.cursor/
.cursorrules
.aider*
.codeium/
.continue/
.copilot/

# ---- 本地开发文档（不上传 GitHub） ----
AI开发指令.md
功能文档.md
AkiraGate_Analysis_ZH.md

# ---- 临时和测试文件 ----
scratch/
*连接配置*
*.bak
*.orig

# ---- 系统文件 ----
.DS_Store
Thumbs.db
Desktop.ini
