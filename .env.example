# Docker Compose 变量示例。
# 这些变量只在 /data/config.json 首次生成时写入应用配置；配置已存在后请通过 Web 管理端或配置文件修改。

# 宿主机监听。Web 默认对外开放；SOCKS5 默认只允许宿主机本机访问。
AKIRAGATE_WEB_BIND=0.0.0.0
AKIRAGATE_WEB_PORT=8787
AKIRAGATE_SOCKS_BIND=127.0.0.1
AKIRAGATE_SOCKS_PORT=7928

# 首次启动凭据。留空时入口脚本会生成随机值，并输出到 docker compose logs。
# AKIRAGATE_SECRET_PATH=
# AKIRAGATE_ADMIN_USERNAME=admin
# AKIRAGATE_ADMIN_PASSWORD=
# AKIRAGATE_API_TOKEN=
# AKIRAGATE_SOCKS_USERNAME=proxy
# AKIRAGATE_SOCKS_PASSWORD=

# 可选：容器内固定 OpenVPN 配置路径。文件需要放在 /data 持久化卷内。
# AKIRAGATE_OPENVPN_CONFIG=/data/client.ovpn
# AKIRAGATE_OPENVPN_AUTH=/data/vpngate_auth.txt
# AKIRAGATE_AUTO_CONNECT=false

# 可选：机器 API 动态代理配置。
# AKIRAGATE_PROXY_CACHE_TTL_SECONDS=3600
# AKIRAGATE_PROXY_LEASE_SECONDS=3600
# AKIRAGATE_PROXY_LISTEN_HOST=0.0.0.0
